import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n=sc.nextInt();
        int[] arr = new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int k = sc.nextInt();
        PriorityQueue<Integer> pq = new PriorityQueue<>();
        int index = 0;
        //6 5 3 2 8 10 9
        //get the k element
        for(int i=0;i<=k && i<n;i++){//i=0..i<3
            pq.add(arr[i]);//[6,5,3,2]
        }
        //[2,3,5,6]
        //update the array + get the next element
        for(int i=k+1;i<n;i++){//i=5//i=6//i=7--loop gets terminated
            //[6 5 3 2 8 10 9]//[2,3,5,6]
            arr[index++]=pq.poll();//[2 5 3 2 8 10 9]//[2 3 3 2 8 10 9]
            pq.add(arr[i]);//[3 5 6 8]//[5 6 8 10]//[6 8 10 9]
        }
        //[8 9 10]//[9 10]//[10]//[]
        while(!pq.isEmpty()){
            arr[index++]=pq.poll();//[2 3 5 6 8 9 10]
        }
        for(int i =0;i<n;i++){
            System.out.print(arr[i]+" ");//[2 3 5 6 8 9 10]
        }
        
        
    }
}
