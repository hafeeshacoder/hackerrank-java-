import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();//5
        int[] arr = new int[n];
        for(int i = 0; i < n; i++)
            arr[i] = sc.nextInt();//1 3 4 10 12

        int x = sc.nextInt();//4
        int k = sc.nextInt();//2

        PriorityQueue<Integer> pq = new PriorityQueue<>((p, q) -> Math.abs(p - x) - Math.abs(q - x));
//|1 - 4| = 3 //|3 - 4| = 1// |10 - 4| = 6//|12 - 4| = 8
        for(int v : arr){
            if(v != x) {
                pq.add(v);//1 3 10 12
            }
        }

        int[] res = new int[k];//[3]//[1]
        for(int i = 0; i < k; i++){
            res[i] = pq.poll();// 3//1
        }
        Arrays.sort(res); // [1 3] 

        for(int v : res){
            System.out.print(v + " ");// 1 3
        }
    }
}
